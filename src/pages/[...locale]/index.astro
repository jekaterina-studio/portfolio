---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import { t } from '../../data/ui';
import { getPage } from '../../lib/content';
import { localeParams, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeParams;
const locale = toLocale(Astro.params.locale);
const page = (await getPage<{ role: string; fields: string; statement: string; tiles?: { image: string; alt: string }[] }>('home', locale))!;
// Tiles live in src/assets/images/site/ (no red overlay: not project documentation).
const siteImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/site/*.{jpg,jpeg}', { eager: true });
const tiles = (page.tiles ?? [])
  .map((t) => ({ ...t, src: siteImages[`../../assets/images/site/${t.image}`]?.default }))
  .filter((t) => t.src);
---
<BaseLayout locale={locale} section="home" mainClass="home">
  <div class="home__intro">
    <h1 class="home__name">{site.name.toLowerCase()}</h1>
    <p class="home__role">{page.role}</p>
    <p class="home__fields muted">{page.fields}</p>
  </div>
  <div class="home__tiles">
    {tiles.map((t) => (
      <Image src={t.src!} alt={t.alt} widths={[200, 373].filter((w) => w <= t.src!.width)} sizes="8rem" loading="eager" class="home__tile" />
    ))}
  </div>
  <div class="home__outro">
    <p class="home__statement">{page.statement}</p>
  </div>
  <!-- CV downloads as a right-aligned list, underlined in red (owner request) -->
  <ul class="home__cv">
    {[[t('cvIt', locale), site.cv.it, 'it'], [t('cvEn', locale), site.cv.en, 'en']].map(([label, href, lang]) => (
      <li>
        {href ? <a href={href} download hreflang={lang}>{label}</a> : <span class="home__cv-item">{label}</span>}
        {!href && <span class="muted"> ({t('cvPending', locale)})</span>}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  /* One screen on desktop: the space between the fixed header and footer.
     Name at the top left, two small square tiles on the right in the middle, statement at the bottom left. */
  :global(main.home) {
    height: 100dvh;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
  }
  .home__intro, .home__outro { grid-column: 1; }
  .home__intro { grid-row: 1; }
  .home__outro { grid-row: 3; }
  .home__name { font-size: var(--fs-h1); }
  .home__role { margin-top: var(--space-1); }
  .home__fields { margin-top: var(--space-1); font-size: var(--fs-small); }
  .home__statement { max-width: 28rem; font-weight: 700; }
  /* CV downloads bottom right, as a right-aligned list (owner request) */
  .home__cv { grid-column: 2; grid-row: 3; align-self: end; justify-self: end; text-align: right; list-style: none; }
  .home__cv li + li { margin-top: var(--space-1); }
  .home__cv a, .home__cv-item { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }

  .home__tiles {
    align-self: center;
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4) 0;
  }
  .home__tiles :global(.home__tile) { width: 8rem; height: 8rem; object-fit: cover; }

  @media (max-width: 47.99rem), (max-height: 31.25rem) {
    :global(main.home) { height: auto; display: block; }
    .home__tiles { padding: var(--space-5) 0; justify-content: flex-end; }
    .home__cv { margin-top: var(--space-5); text-align: right; }
    .home__tiles :global(.home__tile) { width: calc((100% - var(--space-2)) / 2); height: auto; max-width: 8rem; aspect-ratio: 1 / 1; }
  }
</style>
