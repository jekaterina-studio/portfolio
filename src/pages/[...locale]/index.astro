---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Placeholder from '../../components/dev/Placeholder.astro';
import { site } from '../../data/site';
import { nav } from '../../data/ui';
import { getPage } from '../../lib/content';
import { localeParams, localizedPath, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeParams;
const locale = toLocale(Astro.params.locale);
const allWorks = nav.find((n) => n.key === 'all-works')!;
const page = (await getPage<{ role: string; fields: string; statement: string; portrait?: string; portraitAlt?: string }>('home', locale))!;
// Portrait lives in src/assets/images/site/ (no red overlay: not project documentation).
const siteImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/site/*.{jpg,jpeg}', { eager: true });
const portrait = page.portrait ? siteImages[`../../assets/images/site/${page.portrait}`]?.default : undefined;
---
<BaseLayout locale={locale} section="home" mainClass="home">
  <div class="home__text">
    <h1 class="home__name">{site.name.toLowerCase()}</h1>
    <p class="home__role">{page.role}</p>
    <p class="home__fields muted">{page.fields}</p>
    <p class="home__statement">{page.statement}</p>
    <p class="home__link"><a href={localizedPath(locale, ...allWorks.segments)}>{allWorks.label[locale]}</a></p>
  </div>
  <div class="home__portrait">
    {portrait ? (
      <Image src={portrait} alt={page.portraitAlt ?? ''} widths={[400, 800, 1200].filter((w) => w <= portrait.width)} sizes="(max-width: 768px) 100vw, 40vw" loading="eager" class="home__img" />
    ) : (
      <Placeholder label="ritratto personale - JPEG da fornire" />
    )}
  </div>
</BaseLayout>

<style>
  /* One screen on desktop: the space between the fixed header and footer. */
  :global(main.home) {
    height: 100dvh;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }
  .home__text { display: flex; flex-direction: column; }
  .home__name { font-size: var(--fs-h1); }
  .home__role { margin-top: var(--space-1); }
  .home__fields { margin-top: var(--space-1); font-size: var(--fs-small); }
  .home__statement { margin-top: auto; max-width: 28rem; font-weight: 700; }
  .home__link { margin-top: var(--space-4); }
  .home__portrait { min-height: 0; max-width: 32rem; justify-self: end; width: 100%; display: flex; justify-content: flex-end; align-items: flex-start; }
  /* the portrait keeps its own proportions and fits the available height */
  .home__portrait :global(.home__img) { width: auto; max-width: 100%; max-height: 100%; object-fit: contain; }

  @media (max-width: 47.99rem), (max-height: 31.25rem) {
    :global(main.home) { height: auto; grid-template-columns: 1fr; }
    .home__statement { margin-top: var(--space-5); }
    .home__portrait { justify-self: start; justify-content: flex-start; }
    .home__portrait :global(.home__img) { width: 100%; max-height: none; }
  }
</style>
