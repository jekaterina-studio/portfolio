---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoRow from '../../components/InfoRow.astro';
import Prose from '../../components/Prose.astro';
import Placeholder from '../../components/dev/Placeholder.astro';
import { nav, t } from '../../data/ui';
import { site } from '../../data/site';
import { getPage } from '../../lib/content';
import { localeParams, localizedPath, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeParams;
const locale = toLocale(Astro.params.locale);
const label = nav.find((n) => n.key === 'profile')!.label[locale];
const page = (await getPage<any>('profile', locale)) ?? (await getPage<any>('profile', 'it'));
const isFallback = !(await getPage('profile', locale));

// Reference images live in src/assets/images/site/ (shown in original colours).
const siteImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/site/*.{jpg,jpeg}', { eager: true });
const img = (name: string | null) => (name ? siteImages[`../../assets/images/site/${name}`]?.default : undefined);
---
<BaseLayout locale={locale} section="profile" title={label}>
  <h1>{label}</h1>
  {isFallback && <p class="muted" data-placeholder>[EN - approved English copy pending]</p>}

  <div class="rows">
    <InfoRow label={t('biography', locale)}>
      <Prose text={page.biography} />
      <!-- link only, no separate heading (owner request) -->
      <p class="bio-link"><a href={localizedPath(locale, 'projects')}>{locale === 'en' ? 'my experiences' : 'le mie esperienze'} <span aria-hidden="true">→</span></a></p>
    <InfoRow label={t('education', locale)}>
      <ol class="education">
        {page.education.map((e: any) => (
          <li class:list={[e.separatorBefore && 'has-separator']}>
            {e.years ? <p class="education__years">{e.years}</p> : site.showPlaceholders && <p class="education__years placeholder-line">{locale === 'it' ? '[anni da fornire]' : '[years to be supplied]'}</p>}
            <h3>{e.institution}</h3>
            <Prose text={e.qualification} />
            {e.description && <Prose text={e.description} class="muted" />}
            {e.status && <p class="education__status">{e.status}</p>}
          </li>
        ))}
      </ol>
    </InfoRow>
  </div>

  <!-- Personal references: playful subtitle requested by the owner (replaces the "no heading" rule). -->
  {page.referencesTitle && <h2 class="references-title">{page.referencesTitle}</h2>}
  <ul class="references">
    {page.references.map((r: any) => {
      const src = img(r.image);
      return (
        <li>
          <div class="ref-image">
            {src ? <Image src={src} alt={r.alt} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 33vw" /> : <Placeholder label={`immagine: ${r.alt} - da fornire`} />}
          </div>
          <p>{r.phrase}</p>
        </li>
      );
    })}
  </ul>

</BaseLayout>

<style>
  .bio-link { margin-top: 1em; }
  .bio-link a { color: var(--color-accent); font-weight: 700; }
  .bio-link a:hover, .bio-link a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }
  .rows { margin-top: var(--space-5); display: grid; gap: var(--space-5); }
  .education { list-style: none; display: grid; gap: var(--space-4); }
  .education h3 { text-transform: none; }
  .education__status { color: var(--color-accent); font-style: italic; }
  .education__years { font-size: var(--fs-small); color: var(--color-muted); margin-bottom: var(--space-1); font-variant-numeric: tabular-nums; }
  .placeholder-line { background: #f2f2f2; width: fit-content; padding: 0 0.2em; }
  /* thin line requested by the owner between the academic path and VM Academy */
  .education .has-separator { border-top: 1px solid var(--color-rule); padding-top: var(--space-4); } /* institution names keep their capitalisation */
  /* playful subtitle: lowercase, large, bold, red asterisk (owner request) */
  .references-title { margin-top: var(--space-6); font-size: var(--fs-h1); font-weight: 700; text-transform: lowercase; line-height: 1.15; }
  .references-title .star { color: var(--color-accent); margin-right: 0.15em; }
  .references-title + .references { margin-top: var(--space-4); }
  .references {
    list-style: none;
    margin-top: var(--space-6);
    max-width: 72rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .ref-image { aspect-ratio: 4 / 5; } /* owner request: 4:5 */
  .ref-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* reference phrases: uppercase, bold, red (owner request) */
  .references p { margin-top: var(--space-2); text-transform: uppercase; font-weight: 700; color: var(--color-accent); }
  @media (max-width: 63.99rem) { .references { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 40rem; } }
  @media (max-width: 47.99rem) { .references { grid-template-columns: 1fr; max-width: 24rem; } }
</style>
