---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoRow from '../../components/InfoRow.astro';
import Prose from '../../components/Prose.astro';
import DocumentList from '../../components/DocumentList.astro';
import { nav, t } from '../../data/ui';
import { getPage } from '../../lib/content';
import { localeParams, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeParams;
const locale = toLocale(Astro.params.locale);
const label = nav.find((n) => n.key === 'practice')!.label[locale];
const page = (await getPage<any>('practice', locale)) ?? (await getPage<any>('practice', 'it'));
const isFallback = !(await getPage('practice', locale));
---
<BaseLayout locale={locale} section="practice" title={label}>
  <h1>{label}</h1>
  {isFallback && <p class="muted" data-placeholder>[EN - approved English copy pending]</p>}
  <div class="intro"><Prose text={page.intro} /></div>

  <div class="rows">
    <!-- Process as a flow diagram (owner request). Flexible, not rigid: the dashed red line
         shows that the last step can lead back to the first. -->
    <section class="process">
      <h2 class="process__label">{t('process', locale)}</h2>
      <ol class="flow">
        {page.steps.map((s: any, i: number) => (
          <li class="flow__step">
            <span class="flow__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="flow__title">{s.title}</h3>
            <p class="flow__text">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="flow__loop" aria-hidden="true"></div>
    </section>
    <InfoRow label={t('tools', locale)} show={page.tools?.length > 0}>
      <ul class="tools">{page.tools.map((x: any) => <li><strong>{x.label}:</strong> {x.items}</li>)}</ul>
    </InfoRow>
    <InfoRow label={t('workDocuments', locale)} show={page.documents?.length > 0}>
      <DocumentList docs={page.documents ?? []} locale={locale} />
    </InfoRow>
  </div>
</BaseLayout>

<style>
  .intro { margin-top: var(--space-5); }
  .rows { margin-top: var(--space-6); display: grid; gap: var(--space-5); }
  .tools { list-style: none; }

  /* ---- process flow ---- */
  .process__label { font-size: var(--fs-body); margin-bottom: var(--space-4); }
  .process { --node: 2.25rem; }
  .flow { list-style: none; }
  .flow__node {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--node); height: var(--node);
    border: 1px solid var(--color-accent); border-radius: 50%;
    color: var(--color-accent); font-size: var(--fs-small); font-weight: 700;
    background: var(--color-bg);
    position: relative; z-index: 1;
    font-variant-numeric: tabular-nums;
  }
  .flow__title { font-size: var(--fs-body); }
  .flow__text { color: var(--color-muted); font-size: var(--fs-small); margin-top: var(--space-1); }

  /* Desktop: horizontal flow, nodes joined by a red line with arrowheads */
  @media (min-width: 64rem) {
    .flow { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); column-gap: var(--space-3); }
    .flow__step { position: relative; }
    .flow__title { margin-top: var(--space-3); }
    .flow__step:not(:last-child)::after {           /* connecting line */
      content: ''; position: absolute;
      top: calc(var(--node) / 2); left: calc(var(--node) + 0.4rem); right: calc(-1 * var(--space-3) + 0.4rem);
      border-top: 1px solid var(--color-accent);
    }
    .flow__step:not(:last-child)::before {          /* arrowhead */
      content: ''; position: absolute;
      top: calc(var(--node) / 2 - 4px); right: calc(-1 * var(--space-3) + 0.4rem);
      border: 4px solid transparent; border-left: 6px solid var(--color-accent); border-right: 0;
    }
    .flow__loop {                                   /* return path: verificare -> osservare */
      position: relative;
      margin: var(--space-4) 0 0 calc(var(--node) / 2);
      width: calc((100% - 6 * var(--space-3)) / 7 * 6 + 6 * var(--space-3));
      height: var(--space-4);
      border: 1px dashed var(--color-accent); border-top: 0;
    }
    .flow__loop::before {                           /* arrowhead pointing up to the first node */
      content: ''; position: absolute; left: -5px; top: -7px;
      border: 4px solid transparent; border-bottom: 6px solid var(--color-accent); border-top: 0;
    }
  }

  /* Tablet and mobile: vertical flow with the line on the left */
  @media (max-width: 63.99rem) {
    .flow__step {
      position: relative;
      display: grid; grid-template-columns: var(--node) 1fr; column-gap: var(--space-3);
      padding-bottom: var(--space-4);
    }
    .flow__node { grid-row: 1 / span 2; }
    .flow__title { align-self: center; }
    .flow__text { grid-column: 2; }
    .flow__step:not(:last-child)::after {
      content: ''; position: absolute;
      left: calc(var(--node) / 2); top: calc(var(--node) + 0.3rem); bottom: 0.3rem;
      border-left: 1px solid var(--color-accent);
    }
    .flow__step:not(:last-child)::before {
      content: ''; position: absolute;
      left: calc(var(--node) / 2 - 4px); bottom: 0.3rem;
      border: 4px solid transparent; border-top: 6px solid var(--color-accent); border-bottom: 0;
    }
    .flow__loop { display: none; }
  }
</style>
