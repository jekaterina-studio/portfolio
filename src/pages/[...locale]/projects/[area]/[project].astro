---
import { Image } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import InfoRow from '../../../../components/InfoRow.astro';
import Prose from '../../../../components/Prose.astro';
import DocumentList from '../../../../components/DocumentList.astro';
import ImageSeries from '../../../../components/ImageSeries.astro';
import ResponsiveDiagram from '../../../../components/ResponsiveDiagram.astro';
import SlowSlideshow from '../../../../components/SlowSlideshow.astro';
import Gallery from '../../../../components/Gallery.astro';
import { site } from '../../../../data/site';
import ProjectPager from '../../../../components/ProjectPager.astro';
import { nav, t } from '../../../../data/ui';
import { caseAreas, getAreas, getProjects, hasProjectText, projectsInArea, type Project } from '../../../../lib/content';
import { locales, localizedPath, toLocale, defaultLocale, type Locale } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const areas = await getAreas();
  const paths = [];
  for (const locale of locales) {
    const projects = await getProjects(locale);
    for (const p of projects) {
      const siblings = projectsInArea(projects, p.meta.area);
      const i = siblings.findIndex((s) => s.slug === p.slug);
      paths.push({
        params: { locale: locale === defaultLocale ? undefined : locale, area: p.meta.area, project: p.slug },
        props: { project: p, area: areas.find((a) => a.id === p.meta.area)!, prev: i >= 0 ? siblings[i - 1] : undefined, next: i >= 0 ? siblings[i + 1] : undefined },
      });
    }
  }
  return paths;
}

interface Props { project: Project; area: any; prev?: Project; next?: Project }
const { project, area, prev, next } = Astro.props;
const locale = toLocale(Astro.params.locale);
const other: Locale = locale === 'it' ? 'en' : 'it';
const hasTranslation = await hasProjectText(project.slug, other);
const { meta, text } = project;
const areaTitle = area.data.title[locale] ?? area.data.title.it;
const areaHref = localizedPath(locale, 'projects', area.id);
const projectsLabel = nav.find((n) => n.key === 'projects')!.label[locale];
const link = (p?: Project) => p && { href: localizedPath(locale, 'projects', p.meta.area, p.slug), label: p.text.title };
const period = meta.period ? (meta.period[locale] ?? meta.period.it) : null;
const all = await getProjects(locale);
const parent = meta.parent ? all.find((p) => p.slug === meta.parent) : undefined;
const results = typeof text.results === 'string' ? { items: [] as string[], text: text.results } : text.results;
// Brand activation cases use their own section order (owner request):
// descrizione, attività svolte, ruolo, risultati, link utili, galleria fotografica (grid + lightbox).
const isCase = caseAreas.includes(meta.area);
// Independent practice: no dates (owner request)
const hidePeriod = meta.area === 'independent-practice';
const galleryImages = meta.media.flatMap((b) => b.images.map((im) => ({ src: im.file, alt: im.alt[locale] ?? im.alt.it, caption: typeof im.caption === 'string' ? im.caption : im.caption && (im.caption[locale] ?? im.caption.it), format: b.format })));
const galleryFormat = meta.media[0]?.format ?? 'horizontal';
// a section can host the gallery (e.g. vegetherial in floral design)
const sectionGallery = text.sections.some((s) => s.gallery);
const projectHref = (slug: string) => {
  const p = all.find((x) => x.slug === slug);
  return p ? localizedPath(locale, 'projects', p.meta.area, p.slug) : undefined;
};
---
<BaseLayout locale={locale} section="projects" title={text.title} hasTranslation={hasTranslation}>
  <article class="project">
    <header class="project__head">
      <Breadcrumb locale={locale} items={[
        { label: projectsLabel, href: localizedPath(locale, 'projects') },
        { label: areaTitle, href: areaHref },
        { label: text.title },
      ]} />
      <div class="project__title">
        <h1 class:list={[isCase && 'case-title']}>{text.title}</h1>
        {!hidePeriod && <p class="project__period">{period ?? <span class="muted" data-placeholder>[{t('periodTbc', locale)}]</span>}</p>}
      </div>
      {meta.parentText ? (
        <p class="project__meta muted">{meta.parentText[locale] ?? meta.parentText.it}</p>
      ) : parent ? (
        <p class="project__meta muted">{t('partOf', locale)} <a href={localizedPath(locale, 'projects', parent.meta.area, parent.slug)}>{parent.text.title}</a>{meta.place && <> - {meta.place}</>}</p>
      ) : (meta.company && meta.company !== text.title) || meta.place ? (
        <p class="project__meta muted">{[meta.company !== text.title ? meta.company : null, meta.place].filter(Boolean).join(' - ')}</p>
      ) : null}
    </header>

    {isCase ? (
      <>
        <div class="project__rows">
          <InfoRow label={t('description', locale)} show={!!text.description}><Prose text={text.description} />{text.descriptionNote && <div class="muted results-note"><Prose text={text.descriptionNote} /></div>}</InfoRow>
          <InfoRow label={t('activitiesDone', locale)} show={!!text.activities?.length}>
            <ul class="activities">{text.activities?.map((a) => <li><Prose text={a} /></li>)}</ul>
          </InfoRow>
          <InfoRow label={text.roleLabel ?? t('role', locale)} show={!!text.role}><Prose text={text.role} /></InfoRow>
          <InfoRow label={t('results', locale)} show={!!results}>
            {results && 'text' in results && <Prose text={results.text} />}
            {results && 'items' in results && results.items.length > 0 && (
              <>
                {'intro' in results && results.intro && <p class="results-intro">{results.intro}</p>}
                <ul class="activities">{results.items.map((r) => <li><Prose text={r} /></li>)}</ul>
                {'note' in results && results.note && <div class="muted results-note"><Prose text={results.note} /></div>}
              </>
            )}
          </InfoRow>
          {text.sections.map((s) => (
            <InfoRow label={s.label}>
              {s.text && <Prose text={s.text} />}
              {s.items && (
                <ul class="items">{s.items.map((it) => {
                  const href = it.project ? projectHref(it.project) : undefined;
                  return <li>{href ? <a href={href}>{it.title}</a> : it.url ? <a class="item-link" href={it.url} target="_blank" rel="noopener">{it.title}</a> : it.title}</li>;
                })}</ul>
              )}
            </InfoRow>
          ))}
          <InfoRow label={t('occasions', locale)} show={text.occasions.length > 0}>
            <div class="occasions">
              {text.occasions.map((o) => (
                <div class="occasion">
                  <h3 class="occasion__title">{o.title}</h3>
                  <Prose text={o.text} />
                </div>
              ))}
            </div>
          </InfoRow>
        </div>
        {(galleryImages.length > 0 || meta.slideshow.length > 0 || meta.diagram || site.showPlaceholders) && (
          <section class="case-gallery">
            <h2 class="case-gallery__label">{t('gallery', locale)}</h2>
            {meta.diagram ? (
              <ResponsiveDiagram src={meta.diagram.src} alt={meta.diagram.alt} locale={locale} />
            ) : meta.slideshow.length > 0 ? (
              <SlowSlideshow slides={meta.slideshow} locale={locale} />
            ) : galleryImages.length > 0 ? (
              <Gallery images={galleryImages} format={galleryFormat} locale={locale} />
            ) : (
              <div class="case-gallery__placeholder" data-placeholder><span>{t('imagesToCome', locale)}</span></div>
            )}
          </section>
        )}
      </>
    ) : (
      <>
        <div class="project__rows">
          <InfoRow label={t('description', locale)} show={!!text.description}><Prose text={text.description} />{text.descriptionNote && <div class="muted results-note"><Prose text={text.descriptionNote} /></div>}</InfoRow>
          <InfoRow label={text.roleLabel ?? t('role', locale)} show={!!text.role}><Prose text={text.role} /></InfoRow>
          <InfoRow label={t('activities', locale)} show={!!text.activities?.length}>
            <ul class="activities">{text.activities?.map((a) => <li><Prose text={a} /></li>)}</ul>
          </InfoRow>
          {text.sections.map((s) => (
            <InfoRow label={s.label}>
              {s.subtitle && (
                <p slot="sublabel" class:list={['section-subtitle', s.subtitle.italic && 'section-subtitle--italic']}>{s.subtitle.url
                  ? <a class="item-link" href={s.subtitle.url} target="_blank" rel="noopener">{s.subtitle.title}</a>
                  : <span class="item-link">{s.subtitle.title}</span>}</p>
              )}
              {s.text && <Prose text={s.text} />}
              {s.gallery && galleryImages.length > 0 && (
                <div class="section-gallery"><Gallery images={galleryImages} format={galleryFormat} locale={locale} /></div>
              )}
              {s.items && (
                <ul class:list={['items', s.gallery && 'items--after-gallery', meta.thumbnails.length > 0 && 'items--thumbs']}>{s.items.map((it, idx) => {
                  const href = it.project ? projectHref(it.project) : undefined;
                  const thumb = it.url ? meta.thumbnails[idx] : undefined;
                  if (thumb) return (
                    <li class="thumb-item">
                      <a class="item-link" href={it.url} target="_blank" rel="noopener">{it.title}</a>
                      <a class="thumb" href={it.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                        <Image src={thumb.file} alt={thumb.alt[locale] ?? thumb.alt.it} widths={[320, 640]} sizes="16rem" />
                      </a>
                    </li>
                  );
                  // url: external link (bold red); highlight without url: same style, link still to come
                  return <li>{href ? <a href={href}>{it.title}</a> : it.url ? <a class="item-link" href={it.url} target="_blank" rel="noopener">{it.title}</a> : it.highlight ? <span class="item-link">{it.title}</span> : it.title}</li>;
                })}</ul>
              )}
              {s.note && (
                <p class="section-note">{s.note.split(/([\w.+-]+@[\w-]+\.[\w.]+)/).map((part, k) => k % 2 ? <a href={`mailto:${part}`}>{part}</a> : part)}</p>
              )}
            </InfoRow>
          ))}
          <InfoRow label={t('documentation', locale)} show={meta.documents.length > 0}>
            <DocumentList docs={meta.documents} locale={locale} />
          </InfoRow>
          <InfoRow label={t('results', locale)} show={!!results}>
            {results && 'text' in results && <Prose text={results.text} />}
            {results && 'items' in results && results.items.length > 0 && (
              <>
                {'intro' in results && results.intro && <p class="results-intro">{results.intro}</p>}
                <ul class="activities">{results.items.map((r) => <li>{r}</li>)}</ul>
                {'note' in results && results.note && <div class="muted results-note"><Prose text={results.note} /></div>}
              </>
            )}
          </InfoRow>
        </div>

        {meta.slideshow.length > 0 && (
          <section class="case-gallery">
            <h2 class="case-gallery__label">{t('gallery', locale)}</h2>
            <SlowSlideshow slides={meta.slideshow} locale={locale} />
          </section>
        )}

        {meta.diagram && (
          <section class="case-gallery">
            <h2 class="case-gallery__label">{t('gallery', locale)}</h2>
            <ResponsiveDiagram src={meta.diagram.src} alt={meta.diagram.alt} locale={locale} />
          </section>
        )}

        {meta.media.length > 0 && !sectionGallery && (
          <div class="project__media">
            {meta.media.map((block) => (
              <ImageSeries
                layout={block.layout}
                format={block.format}
                locale={locale}
                images={block.images.map((im) => ({ src: im.file, alt: im.alt[locale] ?? im.alt.it }))}
              />
            ))}
          </div>
        )}

      </>
    )}

    {/* Useful links: always right below the photo gallery, only when there are links (owner request) */}
    {text.links.length > 0 && (
      <section class="useful-links">
        <h2 class="case-gallery__label useful-links__label">{t('usefulLinks', locale)}</h2>
        <ul>{text.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}</ul>
      </section>
    )}

    {meta.cta && (
      <>
        {/* inline so the shared project stylesheet stays unchanged */}
        <style is:inline>.case-cta{margin-top:var(--space-6)}.case-cta a{color:var(--color-accent);font-weight:700;text-transform:uppercase;text-decoration:none}.case-cta__arrow{display:inline-block;margin-left:.35em;transition:transform .15s ease}.case-cta a:hover .case-cta__arrow,.case-cta a:focus-visible .case-cta__arrow{transform:translateX(.25em)}@media (prefers-reduced-motion:reduce){.case-cta__arrow{transition:none}}</style>
        <p class="case-cta"><a href={meta.cta.project ? projectHref(meta.cta.project) : localizedPath(locale, 'projects', meta.cta.area)}>{meta.cta.label[locale] ?? meta.cta.label.it}<span class="case-cta__arrow" aria-hidden="true">→</span></a></p>
      </>
    )}

    <footer class="project__nav">
      <ProjectPager locale={locale} prev={link(prev)} next={link(next)} area={{ href: areaHref, label: areaTitle }} />
    </footer>
  </article>
</BaseLayout>

<style>
  .project__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin-top: var(--space-2); }
  .project__period { color: var(--color-muted); }
  .project__meta { margin-top: var(--space-1); }
  .project__rows { margin-top: var(--space-6); display: grid; gap: var(--space-5); }
  .activities, .items { list-style: none; max-width: var(--measure); }
  /* bullet points on activity / result lists (owner request) */
  .activities { list-style: disc; padding-left: 1.2em; }
  /* a single descriptive item reads as a paragraph: no bullet */
  .activities:has(> li:only-child) { list-style: none; padding-left: 0; }
  .activities li::marker { color: var(--color-text); }
  .activities li + li, .items li + li { margin-top: var(--space-1); }
  .project__media { margin-top: var(--space-6); display: grid; gap: var(--space-5); }
  .project__nav { margin-top: var(--space-6); }
  .project__meta a { color: var(--color-text); }
  .project__meta a:hover { color: var(--color-accent); }
  .results-intro { margin-bottom: var(--space-2); }
  .results-note { margin-top: var(--space-2); max-width: var(--measure); font-size: var(--fs-small); }
  .items + :global(.prose), :global(.prose) + .items { margin-top: var(--space-2); }
  /* brand activation cases */
  .case-title { text-transform: none; } /* exact case titles as given by the owner */
  .item-link { color: var(--color-accent); font-weight: 700; }
  .item-link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .section-note { margin-top: var(--space-3); font-size: var(--fs-small); color: var(--color-muted); text-transform: lowercase; }
  .section-note a { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .useful-links { margin-top: var(--space-6); }
  .useful-links ul { list-style: none; font-size: var(--fs-small); }
  /* heading: grey, bold, one point smaller than the other labels (owner request) */
  .useful-links .useful-links__label { color: var(--color-muted); font-weight: 700; font-size: calc(var(--fs-body) - 1pt); }
  .useful-links li + li { margin-top: var(--space-1); }
  .useful-links a { color: var(--color-muted); font-weight: 400; text-transform: lowercase; text-decoration: none; }
  .useful-links a:hover, .useful-links a:focus-visible { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.2em; }
  .placeholder-line { color: var(--color-muted); background: #f2f2f2; width: fit-content; padding: 0 0.2em; }
  .case-gallery { margin-top: var(--space-6); }
  .section-gallery { margin-top: var(--space-4); }
  .items--after-gallery { margin-top: var(--space-4); }
  /* small reference thumbnails under linked items (cantautorato songs) */
  .items--thumbs li + li { margin-top: var(--space-4); }
  .thumb { display: block; width: 16rem; max-width: 100%; aspect-ratio: 16 / 9; overflow: hidden; margin-top: var(--space-2); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* owner request: second song (and every even one) aligned to the right */
  .items--thumbs .thumb-item:nth-child(even) { text-align: right; }
  .items--thumbs .thumb-item:nth-child(even) .thumb { margin-left: auto; }
  /* red label, regular italic (owner request for "last project") */
  .section-subtitle--italic .item-link { font-weight: 400; font-style: italic; }
  span.item-link:hover { text-decoration: none; }
  .occasions { display: grid; gap: var(--space-4); max-width: var(--measure); }
  .occasion__title { text-transform: none; font-size: var(--fs-body); margin-bottom: var(--space-1); }
  .case-gallery__label { font-size: var(--fs-body); margin-bottom: var(--space-3); }
  .case-gallery__placeholder {
    max-width: 40rem; aspect-ratio: 5 / 4; background: #f2f2f2;
    display: flex; align-items: flex-end; padding: var(--space-2);
    font-size: var(--fs-small); color: var(--color-muted);
  }
</style>
