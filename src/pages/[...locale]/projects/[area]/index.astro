---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import ProjectIndex from '../../../../components/ProjectIndex.astro';
import { nav, t } from '../../../../data/ui';
import { getAreas, getProjects, listedInArea } from '../../../../lib/content';
import { localeParams, localizedPath, toLocale } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const areas = await getAreas();
  return localeParams().flatMap(({ params }) => areas.map((a) => ({ params: { ...params, area: a.id }, props: { area: a } })));
}
const { area } = Astro.props;
const locale = toLocale(Astro.params.locale);
const projectsLabel = nav.find((n) => n.key === 'projects')!.label[locale];
const title = area.data.title[locale] ?? area.data.title.it;
const projects = listedInArea(await getProjects(locale), area.id);
const intro = area.data.intro?.[locale];
// Brand activations: list with name, sector, keywords. Independent practice: list without periods (owner requests).
const asList = area.id === 'events-and-brand-activations';
const hidePeriod = area.id === 'independent-practice';
// list display only: lowercase, no commas, no hyphens
const listName = (title: string) => title.toLowerCase().replace(/[,\-]/g, ' ').replace(/\s+/g, ' ').trim();
---
<BaseLayout locale={locale} section="projects" title={title}>
  <Breadcrumb locale={locale} items={[{ label: projectsLabel, href: localizedPath(locale, 'projects') }, { label: title }]} />
  <h1 class="title">{title}</h1>
  {intro && <p class="measure intro">{intro}</p>}
  <!-- Brand activations list (owner request): case name in lowercase without commas or hyphens,
       sector below in small grey, service (role) in red in the second column -->
  {asList ? (
    <ul class="cases">
      {projects.map((p) => (
        <li class="case">
          <a class="case__main" href={localizedPath(locale, 'projects', p.meta.area, p.slug)}>
            <span class="case__name">{listName(p.text.title)}</span>
            <span class="case__sector">{p.text.sector ?? <span class="tbs" data-placeholder>[{t('toSupply', locale)}]</span>}</span>
          </a>
          <span class="case__service">{p.text.keywords?.length ? p.text.keywords.join(', ') : <span class="tbs" data-placeholder>[{t('toSupply', locale)}]</span>}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="index"><ProjectIndex projects={projects} locale={locale} hidePeriod={hidePeriod} /></div>
  )}
</BaseLayout>
<style>
  .title { margin-top: var(--space-2); }
  .intro { margin-top: var(--space-3); }
  .index { margin-top: var(--space-5); }
  /* Brand activations list: name + sector (left), service in red (right) */
  .cases { list-style: none; margin-top: var(--space-5); }
  .case {
    display: grid;
    grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-2) 0;
  }
  .case__main { display: block; }
  .case__name { display: block; font-weight: 700; }
  .case__sector { display: block; font-size: var(--fs-small); color: var(--color-muted); margin-top: 0.1rem; }
  .case__service { color: var(--color-accent); }
  .case__main:hover .case__name, .case__main:focus-visible .case__name { color: var(--color-accent); }
  .tbs { background: #f2f2f2; color: var(--color-muted); padding: 0 0.2em; }
  @media (max-width: 47.99rem) {
    .case { grid-template-columns: 1fr; padding: var(--space-2) 0; }
    .case__service { font-size: var(--fs-small); margin-top: 0.1rem; }
  }
</style>
