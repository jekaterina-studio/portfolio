---
/* Phase 2 review page. Not linked from the site; DELETE BEFORE LAUNCH. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSeries from '../components/ImageSeries.astro';
import CvLinks from '../components/CvLinks.astro';
import sq1 from '../assets/images/_test/test-square-1.jpg';
import sq2 from '../assets/images/_test/test-square-2.jpg';
import sq3 from '../assets/images/_test/test-square-3.jpg';
import h1 from '../assets/images/_test/test-horizontal-1.jpg';
import h2 from '../assets/images/_test/test-horizontal-2.jpg';
import h3 from '../assets/images/_test/test-horizontal-3.jpg';

const locale = 'it' as const;
const squares = [sq1, sq2, sq3].map((src, i) => ({ src, alt: `Immagine di prova quadrata ${i + 1}` }));
const horizontals = [h1, h2, h3].map((src, i) => ({ src, alt: `Immagine di prova orizzontale ${i + 1}` }));
---
<BaseLayout locale={locale} title="design system" noindex hasTranslation={false}>
  <div class="stack-lg">
    <section class="stack">
      <p class="muted">Pagina di verifica Phase 2 - non pubblica. Le immagini sono tavole di prova sintetiche, non documentazione.</p>
      <h1>design system</h1>
    </section>

    <section class="stack">
      <h2>tipografia</h2>
      <div class="info-row"><p class="muted">h1</p><p style="font-size:var(--fs-h1);font-weight:700;line-height:1.2">titolo principale - 28px bold</p></div>
      <div class="info-row"><p class="muted">h2</p><p style="font-size:var(--fs-h2);font-weight:700">titolo di sezione - 18px bold</p></div>
      <div class="info-row"><p class="muted">testo</p><p>Testo corrente in Helvetica Regular 16px con interlinea 1,5. Le maiuscole editoriali del testo restano quelle originali, mentre titoli e navigazione sono sempre in minuscolo. La larghezza della colonna è limitata per una lettura comoda.</p></div>
      <div class="info-row"><p class="muted">piccolo</p><p style="font-size:var(--fs-small)">Header, footer, metadati - 13px</p></div>
      <div class="info-row"><p class="muted">link</p><p><a href="#colori">link: nero, rosso al passaggio del puntatore</a></p></div>
    </section>

    <section class="stack" id="colori">
      <h2>colori</h2>
      <ul class="swatches">
        <li><span style="background:#fff;outline:1px solid #ddd"></span>sfondo #FFFFFF</li>
        <li><span style="background:#000"></span>testo #000000</li>
        <li><span style="background:var(--color-muted)"></span>secondario #6B6B6B</li>
        <li><span style="background:var(--color-accent)"></span>accento #D62828</li>
      </ul>
    </section>

    <section class="stack">
      <h2>riga informativa a due colonne</h2>
      <div class="info-row"><h3>descrizione</h3><p>Etichetta a sinistra, contenuto a destra. Su mobile le due colonne si impilano.</p></div>
      <div class="info-row"><h3>attività</h3><ul style="list-style:none"><li>Prima attività</li><li>Seconda attività</li></ul></div>
    </section>

    <section class="stack">
      <h2>immagine singola - quadrata</h2>
      <ImageSeries images={[squares[0]]} layout="single" format="square" locale={locale} />
    </section>
    <section class="stack">
      <h2>immagine singola - orizzontale 5:4</h2>
      <ImageSeries images={[horizontals[0]]} layout="single" format="horizontal" locale={locale} />
    </section>
    <section class="stack">
      <h2>serie quadrata</h2>
      <ImageSeries images={squares} layout="series" format="square" locale={locale} />
    </section>
    <section class="stack">
      <h2>serie orizzontale</h2>
      <ImageSeries images={horizontals.slice(0, 2)} layout="series" format="horizontal" locale={locale} />
    </section>
    <section class="stack">
      <h2>slideshow manuale</h2>
      <ImageSeries images={horizontals} layout="slideshow" format="horizontal" locale={locale} />
    </section>

    <section class="stack">
      <h2>cv</h2>
      <CvLinks locale={locale} />
    </section>

    <section class="stack">
      <h2>ultima sezione</h2>
      <p>Questa riga deve restare interamente leggibile sopra il footer fisso, anche a fine pagina.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .swatches { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-4); font-size: var(--fs-small); }
  .swatches li { display: flex; align-items: center; gap: var(--space-2); }
  .swatches span { width: 2rem; height: 2rem; display: inline-block; }
</style>
