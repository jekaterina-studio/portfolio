---
import { site } from '../data/site';
import { t } from '../data/ui';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale; class?: string }
const { locale, class: className } = Astro.props;
// one link per language version: "Scarica CV" (Italian CV) on the Italian site, "Download CV" (English CV) on the English site (owner request)
const items = [{ href: site.cv[locale], label: t('cv', locale), lang: locale }];
---
<ul class:list={['cv-links', className]}>
  {items.map((cv) => (
    <li>
      {cv.href ? (
        <a href={cv.href} download hreflang={cv.lang}>{cv.label}</a>
      ) : (
        /* File not supplied yet: plain text, not a link. */
        <span class="muted">{cv.label} ({t('cvPending', locale)})</span>
      )}
    </li>
  ))}
</ul>

<style>
  .cv-links { list-style: none; }
</style>
