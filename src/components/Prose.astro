---
/** Renders plain text as paragraphs (blank line = new paragraph, single line break = <br>).
    Text starting with "[DA FORNIRE" is shown as a visible placeholder. */
interface Props { text?: string | null; class?: string }
const { text, class: className } = Astro.props;
const placeholder = !text || /^\[DA FORNIRE/.test(text);
const paragraphs = (text ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
// **text** = bold (as in the approved documents); [text](url) = link (bold red, new tab);
// **[text](url)** = bold link; {{text}} = small red note (e.g. 'in corso'); *text* = italic (titles)
type Part = { t: string; bold?: boolean; href?: string; note?: boolean; italic?: boolean };
const parts = (p: string): Part[] => {
  const out: Part[] = [];
  const re = /\*\*\[(.+?)\]\((.+?)\)\*\*|\[(.+?)\]\((.+?)\)|\*\*(.+?)\*\*|\{\{(.+?)\}\}|\*([^*\s][^*]*?)\*/g;
  let last = 0; let m: RegExpExecArray | null;
  while ((m = re.exec(p))) {
    if (m.index > last) out.push({ t: p.slice(last, m.index) });
    if (m[1]) out.push({ t: m[1], href: m[2] });
    else if (m[3]) out.push({ t: m[3], href: m[4] });
    else if (m[5]) out.push({ t: m[5], bold: true });
    else if (m[6]) out.push({ t: m[6], note: true });
    else out.push({ t: m[7], italic: true });
    last = re.lastIndex;
  }
  if (last < p.length) out.push({ t: p.slice(last) });
  return out;
};
---
{placeholder ? (
  <p class:list={['placeholder-text', className]} data-placeholder>{text ?? '[DA FORNIRE]'}</p>
) : (
  <div class:list={['prose', className]}>{paragraphs.map((p) => <p>{p.split('\n').map((line, li) => (<>{li > 0 && <br />}{parts(line).map((x) => (x.href ? <a class="prose-link" href={x.href} target="_blank" rel="noopener">{x.t}</a> : x.bold ? <strong>{x.t}</strong> : x.italic ? <em>{x.t}</em> : x.note ? <span style="color:var(--color-accent);font-size:var(--fs-small)">{x.t}</span> : x.t))}</>))}</p>)}</div>
)}
<style>
  .prose { max-width: var(--measure); }
  .prose p + p { margin-top: 1em; }
  .prose-link { color: var(--color-accent); font-weight: 700; }
  .prose-link:hover, .prose-link:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }
  .placeholder-text { color: var(--color-muted); background: #f2f2f2; width: fit-content; padding: 0 0.2em; }
</style>
