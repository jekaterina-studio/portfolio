---
/**
 * Slow, endless horizontal slideshow (owner request for Superconnection):
 * photos glide from right to left in a loop, no captions. The strip is
 * repeated once so the loop has no gap; it pauses on hover/focus and stops
 * (scrollable by hand) for people who prefer reduced motion.
 * Images come ready-made from public/ (800 and 1600 px WebP, not recompressed).
 */
import type { Locale } from '../lib/i18n';
import { t } from '../data/ui';

interface Slide { src: string; width: number; height: number; alt: { it: string; en?: string } }
interface Props { slides: Slide[]; locale: Locale; secondsPerSlide?: number }
const { slides, locale, secondsPerSlide = 20 } = Astro.props;
const duration = slides.length * secondsPerSlide;
const img = (s: Slide, i: number, copy: boolean) => ({
  src: `${s.src}-800.webp`,
  srcset: `${s.src}-800.webp 800w, ${s.src}-1600.webp 1600w`,
  sizes: '(max-width: 768px) 26rem, 40rem',
  width: s.width,
  height: s.height,
  alt: copy ? '' : (s.alt[locale] ?? s.alt.it),
  loading: (!copy && i < 3 ? 'eager' : 'lazy') as 'eager' | 'lazy',
  decoding: 'async' as const,
});
---
<div class="slow-slideshow" role="region" aria-label={t('gallery', locale)} tabindex="0" style={`--slow-duration:${duration}s`}>
  <ul class="slow-slideshow__track">
    {slides.map((s, i) => <li><img {...img(s, i, false)} /></li>)}
    {slides.map((s, i) => <li aria-hidden="true"><img {...img(s, i, true)} /></li>)}
  </ul>
</div>
<style is:inline>
  .slow-slideshow { overflow: hidden; width: 100%; }
  .slow-slideshow__track { display: flex; gap: var(--space-3); width: max-content; list-style: none; margin: 0; padding: 0;
    animation: slow-slideshow-loop var(--slow-duration, 220s) linear infinite; }
  .slow-slideshow:hover .slow-slideshow__track, .slow-slideshow:focus-within .slow-slideshow__track { animation-play-state: paused; }
  .slow-slideshow__track li { flex: none; }
  .slow-slideshow__track img { display: block; height: 22rem; width: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  @keyframes slow-slideshow-loop { to { transform: translateX(calc(-50% - var(--space-3) / 2)); } }
  @media (max-width: 47.99rem) { .slow-slideshow__track img { height: 14rem; } }
  @media (prefers-reduced-motion: reduce) {
    .slow-slideshow { overflow-x: auto; }
    .slow-slideshow__track { animation: none; }
    .slow-slideshow__track li[aria-hidden="true"] { display: none; }
  }
</style>
