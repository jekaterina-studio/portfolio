---
/** Two-column row: label | content. Renders nothing when `show` is false (no empty fields). */
interface Props { label: string; show?: boolean }
const { label, show = true } = Astro.props;
---
{show && (
  <section class="info-row">
    <h2 class="info-row__label">{label}</h2>
    <div class="info-row__content"><slot /></div>
  </section>
)}
<style>
  .info-row__label { font-size: var(--fs-body); }
</style>
