---
/**
 * Documentary image for project pages, shown in its original colours
 * (the red overlay was removed at the owner's request).
 */
import { Image, getImage } from 'astro:assets';
import { t } from '../data/ui';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../lib/i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  format: 'square' | 'horizontal' | 'vertical' | 'portrait' | 'wide';
  locale: Locale;
  sizes?: string;
  caption?: string;
  loading?: 'lazy' | 'eager';
  /** clickable: opens the enlarged image in the lightbox */
  zoom?: boolean;
}
const { src, alt, format, locale, caption, loading = 'lazy', zoom = false,
  sizes = '(max-width: 768px) 100vw, 50vw' } = Astro.props;
const full = zoom ? await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' }) : null;
const Frame = zoom ? 'button' : 'div';
// caption: a line break starts a new line; **text** = bold
const captionLines = (caption ?? '').split('\n').map((l) => l.split(/\*\*(.+?)\*\*/g));
---
<figure class:list={['doc-image', `doc-image--${format}`]}>
  <Frame class="doc-image__frame" {...(zoom ? { type: 'button', 'data-zoom': full!.src, 'aria-label': `${t('enlarge', locale)}: ${alt}` } : {})}>
    <Image
      src={src}
      alt={alt}
      format="webp"
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  </Frame>
  {caption && <figcaption class="muted">{captionLines.map((parts, li) => (<>{li > 0 && <br />}{parts.map((x, i) => (i % 2 ? <strong>{x}</strong> : x))}</>))}</figcaption>}
</figure>

<style>
  .doc-image__frame { display: block; width: 100%; overflow: hidden; padding: 0; border: 0; background: none; }
  button.doc-image__frame { cursor: zoom-in; }
  button.doc-image__frame:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .doc-image--square .doc-image__frame { aspect-ratio: 1 / 1; }
  .doc-image--horizontal .doc-image__frame { aspect-ratio: 5 / 4; }
  .doc-image--vertical .doc-image__frame { aspect-ratio: 3 / 4; }
  .doc-image--portrait .doc-image__frame { aspect-ratio: 4 / 5; }
  .doc-image--wide .doc-image__frame { aspect-ratio: 16 / 9; }
  .doc-image__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: var(--fs-small); margin-top: var(--space-2); }
</style>
