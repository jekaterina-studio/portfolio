---
/**
 * Documentary image for project pages, shown in its original colours
 * (the red overlay was removed at the owner's request).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../lib/i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  format: 'square' | 'horizontal' | 'vertical';
  locale: Locale;
  sizes?: string;
  caption?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, format, caption, loading = 'lazy',
  sizes = '(max-width: 768px) 100vw, 50vw' } = Astro.props;
---
<figure class:list={['doc-image', `doc-image--${format}`]}>
  <div class="doc-image__frame">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  </div>
  {caption && <figcaption class="muted">{caption}</figcaption>}
</figure>

<style>
  .doc-image__frame { display: block; width: 100%; overflow: hidden; }
  .doc-image--square .doc-image__frame { aspect-ratio: 1 / 1; }
  .doc-image--horizontal .doc-image__frame { aspect-ratio: 5 / 4; }
  .doc-image--vertical .doc-image__frame { aspect-ratio: 3 / 4; }
  .doc-image__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: var(--fs-small); margin-top: var(--space-2); }
</style>
