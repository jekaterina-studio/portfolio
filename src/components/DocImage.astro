---
/**
 * Documentary image with the red-to-colour interaction.
 * Use ONLY for project documentation (not the home portrait or profile references).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../data/ui';
import type { Locale } from '../lib/i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  format: 'square' | 'horizontal';
  locale: Locale;
  sizes?: string;
  caption?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, format, locale, caption, loading = 'lazy',
  sizes = '(max-width: 768px) 100vw, 50vw' } = Astro.props;
---
<figure class:list={['doc-image', `doc-image--${format}`]}>
  <button type="button" class="doc-image__toggle" aria-pressed="false">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
    <span class="visually-hidden">{t('imageHint', locale)}</span>
  </button>
  {caption && <figcaption class="muted">{caption}</figcaption>}
</figure>

<style>
  .doc-image__toggle {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  .doc-image--square .doc-image__toggle { aspect-ratio: 1 / 1; }
  .doc-image--horizontal .doc-image__toggle { aspect-ratio: 5 / 4; }

  .doc-image__toggle :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Default state: red, semi-transparent overlay that keeps the photo readable. */
  .doc-image__toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--overlay-color);
    mix-blend-mode: var(--overlay-blend);
    opacity: var(--overlay-opacity);
    transition: opacity var(--overlay-transition);
    pointer-events: none;
  }

  /* Mouse: hover reveals the original colours; leaving restores the red. */
  @media (hover: hover) and (pointer: fine) {
    .doc-image__toggle:hover::after { opacity: 0; }
  }
  /* Touch / keyboard: toggled state. */
  .doc-image__toggle[aria-pressed='true']::after { opacity: 0; }

  figcaption { font-size: var(--fs-small); margin-top: var(--space-2); }

  @media print { .doc-image__toggle::after { display: none; } }
</style>
