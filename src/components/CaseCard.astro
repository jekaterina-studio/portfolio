---
/**
 * Visual, clickable card for a brand activation case (category page).
 * Shows only the cover image and the exact case title.
 * Without a cover, a neutral placeholder keeps the layout until the photo is supplied.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../data/ui';
import type { Locale } from '../lib/i18n';

interface Props { href: string; title: string; locale: Locale; cover?: { file: ImageMetadata; alt: string } }
const { href, title, locale, cover } = Astro.props;
---
<a class="case-card" href={href}>
  <span class="case-card__media">
    {cover ? (
      <Picture src={cover.file} alt={cover.alt} formats={['avif', 'webp']}
        widths={[400, 800, 1200].filter((w) => w <= cover.file.width)}
        sizes="(max-width: 768px) 100vw, 25vw" loading="lazy" />
    ) : (
      <span class="case-card__placeholder" data-placeholder>{t('imageToCome', locale)}</span>
    )}
  </span>
  <span class="case-card__title">{title}</span>
</a>

<style>
  .case-card { display: block; }
  .case-card__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #f2f2f2; }
  .case-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Same red-to-colour language as the documentary images: red by default, colour on hover/focus */
  .case-card__media:has(img)::after {
    content: ''; position: absolute; inset: 0;
    background: var(--overlay-color); mix-blend-mode: var(--overlay-blend);
    opacity: var(--overlay-opacity); transition: opacity var(--overlay-transition);
  }
  .case-card:hover .case-card__media::after,
  .case-card:focus-visible .case-card__media::after { opacity: 0; }
  .case-card__placeholder {
    position: absolute; inset: auto 0 0 0; padding: var(--space-2);
    font-size: var(--fs-small); color: var(--color-muted);
  }
  .case-card__title { display: block; margin-top: var(--space-2); font-weight: 700; }
  .case-card:hover .case-card__title, .case-card:focus-visible .case-card__title { color: var(--color-accent); }
</style>
