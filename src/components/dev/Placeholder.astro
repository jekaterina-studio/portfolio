---
/** Visible marker for content not supplied yet. Must not ship in a published page. */
interface Props { label: string; ratio?: string }
const { label, ratio } = Astro.props;
---
<div class="placeholder" style={ratio ? `aspect-ratio:${ratio}` : undefined} data-placeholder>
  <span>{label}</span>
</div>
<style>
  .placeholder {
    background: #f2f2f2;
    color: var(--color-muted);
    font-size: var(--fs-small);
    display: flex; align-items: flex-end;
    padding: var(--space-2);
    width: 100%; height: 100%;
  }
</style>
